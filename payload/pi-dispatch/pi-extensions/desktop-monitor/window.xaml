<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pi Monitor" Width="600" Height="520" MinWidth="460" MinHeight="380" Topmost="True" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FAFDFEFF"/>
  <SolidColorBrush x:Key="SurfaceBorder" Color="#E3E7EF"/>
  <SolidColorBrush x:Key="SoftSurface" Color="#F0F4FA"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#172033"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#596A82"/>
  <SolidColorBrush x:Key="TextMuted" Color="#707F94"/>
  <SolidColorBrush x:Key="StateReady" Color="#0066CC"/><SolidColorBrush x:Key="StateReadyTint" Color="#E5EFFF"/>
  <SolidColorBrush x:Key="StateRunning" Color="#087F5B"/><SolidColorBrush x:Key="StateRunningTint" Color="#E0F5EA"/>
  <SolidColorBrush x:Key="StateWaiting" Color="#946000"/><SolidColorBrush x:Key="StateWaitingTint" Color="#FFF1D6"/>
  <SolidColorBrush x:Key="StateFailed" Color="#C5273A"/><SolidColorBrush x:Key="StateFailedTint" Color="#FDE8EB"/>
  <SolidColorBrush x:Key="StateMuted" Color="#596A82"/><SolidColorBrush x:Key="StateMutedTint" Color="#EEF2F7"/>
  <LinearGradientBrush x:Key="AvatarFill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EDF6FF" Offset="0"/><GradientStop Color="#BBD9FF" Offset="1"/></LinearGradientBrush>
  <DropShadowEffect x:Key="FloatingShadow" Color="#23344F" BlurRadius="14" ShadowDepth="3" Opacity="0.18"/>
  <Style x:Key="FloatingSurface" TargetType="Border"><Setter Property="Margin" Value="10"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="28"/><Setter Property="Effect" Value="{StaticResource FloatingShadow}"/></Style>
  <Style x:Key="PetButton" TargetType="Button"><Setter Property="Foreground" Value="#26354B"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#10007AFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="#22007AFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#007AFF"/><Setter TargetName="surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PetMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#202631"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="10,9" Margin="3,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="check" Visibility="Hidden" Data="M 2,7 L 5,10 L 11,3" Stroke="#007AFF" StrokeThickness="2" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="#E7F0FE"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PetMenu" TargetType="ContextMenu"><Setter Property="ItemContainerStyle" Value="{StaticResource PetMenuItem}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="14" Padding="4"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button" BasedOn="{StaticResource PetButton}"><Setter Property="Padding" Value="9,6"/></Style>
  <Style x:Key="Grip" TargetType="Thumb"><Setter Property="Cursor" Value="SizeAll"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="3" Height="18" CornerRadius="1.5" Background="#BEC8D6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="toggle" Background="#EEF2F7" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="toggle" Property="Background" Value="{StaticResource StateReadyTint}"/><Setter Property="Foreground" Value="{StaticResource StateReady}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="toggle" Property="BorderBrush" Value="{StaticResource StateReady}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="toggle" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="{StaticResource SoftSurface}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style x:Key="HeaderToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource PetButton}"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="headerButton" CornerRadius="12" Background="#EEF2F7" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="headerButton" Property="BorderBrush" Value="{StaticResource StateReady}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="headerButton" Property="Background" Value="{StaticResource StateReadyTint}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="headerButton" Property="BorderBrush" Value="{StaticResource StateReady}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Border x:Name="petSurface" Visibility="Collapsed" Padding="8" Style="{StaticResource FloatingSurface}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <Thumb x:Name="petDrag" Cursor="SizeAll" ToolTip="拖动迷你宠物" AutomationProperties.Name="拖动迷你宠物"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="3" Height="18" CornerRadius="1.5" Background="#BEC8D6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
    <Button x:Name="petOpen" Grid.Column="1" Style="{StaticResource PetButton}" ToolTip="展开 Pi 监控面板" AutomationProperties.Name="展开 Pi 监控面板">
     <Grid Width="228"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
      <Border x:Name="petOrb" Width="46" Height="46" CornerRadius="16" VerticalAlignment="Center" BorderBrush="#C6DEFF" BorderThickness="0.5"><Border.Background><StaticResource ResourceKey="AvatarFill"/></Border.Background><Grid x:Name="petFace" Width="26" Height="24"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"><Border x:Name="eyeLeft" Width="5" Height="8" CornerRadius="2.5" Background="#007AFF" Margin="0,0,6,0"/><Border x:Name="eyeRight" Width="5" Height="8" CornerRadius="2.5" Background="#007AFF"/></StackPanel><Path x:Name="petSmile" Data="M 9,17 Q 13,21 17,17" Stroke="#007AFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,5,0"><TextBlock x:Name="petLabel" Text="Pi 正在连接" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/><TextBlock x:Name="petDetail" Text="等待网关状态" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Border x:Name="petBadge" Grid.Column="2" Background="{StaticResource StateReadyTint}" CornerRadius="12" Height="24" VerticalAlignment="Center"><TextBlock x:Name="petCount" Text="?" Foreground="#007AFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     </Grid>
    </Button>
    <Button x:Name="petMenuButton" Grid.Column="2" Height="32" Style="{StaticResource PetButton}" Padding="0" Background="#EEF2F7" ToolTip="宠物菜单" AutomationProperties.Name="宠物菜单"><StackPanel Orientation="Horizontal"><Ellipse Width="3" Height="3" Fill="#5B6D85" Margin="1.5,0"/><Ellipse Width="3" Height="3" Fill="#5B6D85" Margin="1.5,0"/><Ellipse Width="3" Height="3" Fill="#5B6D85" Margin="1.5,0"/></StackPanel></Button>
   </Grid>
  </Border>
  <Border x:Name="panelSurface" Style="{StaticResource FloatingSurface}">
 <Grid Margin="20,16,20,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Thumb x:Name="panelDrag" Width="15" Height="34" Margin="-8,0,4,0" Style="{StaticResource Grip}" ToolTip="拖动监控窗"/><Border Background="{StaticResource AvatarFill}" CornerRadius="14" Width="40" Height="40" Margin="0,0,10,0"><Viewbox Width="26" Height="24"><Grid Width="26" Height="24"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"><Border Width="5" Height="8" CornerRadius="2.5" Background="{StaticResource StateReady}" Margin="0,0,6,0"/><Border Width="5" Height="8" CornerRadius="2.5" Background="{StaticResource StateReady}"/></StackPanel><Path Data="M 9,17 Q 13,21 17,17" Stroke="{StaticResource StateReady}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></Viewbox></Border><StackPanel><TextBlock Text="Pi Monitor" FontSize="19" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="connectionDot" Width="6" Height="6" Fill="#E4B76D" Margin="0,0,6,0"/><TextBlock x:Name="connection" Text="正在连接" Style="{StaticResource Caption}"/></StackPanel></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="toPet" Style="{StaticResource HeaderButton}" Content="宠物" ToolTip="收起为迷你宠物"/><CheckBox x:Name="compact" Style="{StaticResource HeaderToggle}" Content="精简" ToolTip="收起任务列表，只显示实时概况"/><CheckBox x:Name="pin" Style="{StaticResource HeaderToggle}" Content="置顶" IsChecked="True" ToolTip="保持窗口在其它窗口上方"/><Button x:Name="closeMonitor" Style="{StaticResource HeaderButton}" Width="32" Content="×" FontSize="18" Margin="6,0,0,0" ToolTip="退出监控，不停止任务" AutomationProperties.Name="退出监控"/></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,16">
   <Border Style="{StaticResource Metric}" Margin="0,0,6,0"><StackPanel><TextBlock Text="运行中" Style="{StaticResource Caption}"/><TextBlock x:Name="activeCount" Text="—" Foreground="{StaticResource StateRunning}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Metric}" Margin="3,0,3,0"><StackPanel><TextBlock Text="等待执行" Style="{StaticResource Caption}"/><TextBlock x:Name="queuedCount" Text="—" Foreground="{StaticResource StateWaiting}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Metric}" Margin="6,0,0,0"><StackPanel><TextBlock Text="网关内存 · MiB" Style="{StaticResource Caption}"/><TextBlock x:Name="memoryCount" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
  </UniformGrid>
  <Grid x:Name="taskArea" Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10"><TextBlock x:Name="taskHeading" Text="最近任务" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="activeOnly" Content="仅进行中" HorizontalAlignment="Right" ToolTip="隐藏已结束的任务"/></Grid>
   <ScrollViewer x:Name="taskScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="tasks"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{StaticResource SoftSurface}" CornerRadius="16" Margin="0,0,0,8" Padding="12,10" BorderThickness="3,0,0,0" BorderBrush="{Binding accent}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding role}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{Binding tint}" CornerRadius="8" Padding="8,4" Margin="8,0"><TextBlock Text="{Binding label}" Foreground="{Binding accent}" FontSize="11"/></Border><TextBlock Grid.Column="2" Text="{Binding duration}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/></Grid>
       <TextBlock Grid.Row="1" Text="{Binding route}" ToolTip="{Binding route}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
       <TextBlock Grid.Row="2" Text="{Binding requestId}" ToolTip="{Binding requestId}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <StackPanel x:Name="emptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,10">
    <Border Background="{StaticResource StateReadyTint}" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12"><TextBlock Text="○" Foreground="{StaticResource StateReady}" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock x:Name="emptyTitle" Text="正在获取任务状态" FontSize="15" HorizontalAlignment="Center"/>
    <TextBlock x:Name="emptyHint" Text="连接成功后自动更新" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="status" Text="只读监控 · 关闭窗口不影响任务" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="updated" Grid.Column="1" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="8,0,0,0"/></Grid></Border>
 </Grid>
  </Border>
 </Grid>
</Window>
