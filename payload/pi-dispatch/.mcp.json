{
  "mcpServers": {
    "pi-kether-gateway": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/stdio-server.mjs"
      ],
      "env": {
        "PI_GATEWAY_ROOTS": "[\"${PLUGIN_ROOT}\"]"
      },
      "enabled": true,
      "enabled_tools": [
        "get_workflow",
        "list_capabilities",
        "dispatch_subagent",
        "submit_subagent",
        "get_subagent_status",
        "list_subagents",
        "cancel_subagent",
        "render_subagent_monitor",
        "probe_model",
        "lsp_request",
        "get_subagent_result",
        "renew_claude_auth"
      ],
      "startup_timeout_sec": 30
    }
  }
}
